%------------------------------
% Beamer Settings
%------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeSimpleUUlm}[2026/07/01 SimpleUUlm outer theme]

\mode<presentation>

% faculty=medicine|engineering|math|science|default, e.g.
% \usetheme[faculty=engineering]{SimpleUUlm}
\def\SimpleUUlm@faculty{default}
\DeclareOptionBeamer{faculty}{\def\SimpleUUlm@faculty{#1}}
% progressbar: opt-in progress bar under each frame title, e.g.
% \usetheme[progressbar]{SimpleUUlm}
\def\SimpleUUlm@pbenabled{false}
\DeclareOptionBeamer{progressbar}[true]{\def\SimpleUUlm@pbenabled{true}}
% progressbarheight: thickness of the progress bar (default 2pt), e.g.
% \usetheme[progressbar,progressbarheight=3pt]{SimpleUUlm}
\def\SimpleUUlm@pbheightopt{2pt}
\DeclareOptionBeamer{progressbarheight}{\def\SimpleUUlm@pbheightopt{#1}}
% progressbarscope=all|main: what the progress bar counts (default all).
% main: the bar reaches 100% on the last frame before \appendix and stays
% full on appendix frames (e.g. references, backup slides), e.g.
% \usetheme[progressbar,progressbarscope=main]{SimpleUUlm}
\def\SimpleUUlm@pbscope{all}
\DeclareOptionBeamer{progressbarscope}{\def\SimpleUUlm@pbscope{#1}}
\ProcessOptionsBeamer

\usefonttheme{SimpleUUlm}
\usecolortheme{SimpleUUlm}
\useinnertheme{SimpleUUlm}

\expandafter\setfacultycolor\expandafter{\SimpleUUlm@faculty}

\mode<all>
